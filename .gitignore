# Raw source material — never commit. Contains personal email addresses,
# phone numbers, and mailing addresses lifted straight from mail clients.
*.eml
*.msg
_source/

# Raw photo drops at the repo root. Phone photos carry GPS coordinates and
# timestamps in EXIF, so never commit one directly. Process it (rotate, crop,
# strip EXIF) into a site's assets/ folder and commit that instead.
/*.jpeg
/*.jpg
/*.png
/*.heic
/*.mov
/*.mp4

